<Window x:Class="RecurFolder.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About RecurFolder"
        Icon="pack://application:,,,/Assets/RecurFolder.ico"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <StackPanel Margin="32,24,32,22" MinWidth="320">
        <Image Width="72"
               Height="72"
               HorizontalAlignment="Center"
               RenderOptions.BitmapScalingMode="HighQuality"
               Source="pack://application:,,,/Assets/RecurFolder.png"/>
        <TextBlock Text="RecurFolder"
                   Margin="0,12,0,0"
                   HorizontalAlignment="Center"
                   FontSize="20"
                   FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
        <TextBlock Margin="0,6,0,0"
                   HorizontalAlignment="Center"
                   Text="Created by Smilu Varghese"/>
        <TextBlock Margin="0,14,0,0"
                   HorizontalAlignment="Center"
                   Text="Open source"/>
        <TextBlock Margin="0,4,0,0"
                   HorizontalAlignment="Center">
            <Hyperlink NavigateUri="https://github.com/smiluv/recurfolder"
                       Foreground="{DynamicResource AccentBrush}"
                       RequestNavigate="Link_RequestNavigate">https://github.com/smiluv/recurfolder</Hyperlink>
        </TextBlock>
        <Button Content="OK"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                MinWidth="88"
                IsDefault="True"
                IsCancel="True"
                Style="{StaticResource PrimaryButton}"
                Click="OkButton_Click"/>
    </StackPanel>
</Window>
