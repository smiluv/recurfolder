<Window x:Class="RecurFolder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="RecurFolder"
        Icon="pack://application:,,,/Assets/RecurFolder.ico"
        Height="740"
        Width="1240"
        MinHeight="560"
        MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="#EFEAE2"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        PreviewDrop="Window_PreviewDrop"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Width="36"
                   Height="36"
                   Margin="0,2,12,0"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   Source="pack://application:,,,/Assets/RecurFolder.ico"/>
            <StackPanel Grid.Column="1">
                <TextBlock Text="RecurFolder"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="#1F1A17"/>
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Foreground="#6F675F"
                           TextWrapping="Wrap"
                           Text="Walk every nested folder and file, then search the list or save it as Excel, CSV, or PDF."/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="200"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*" MinWidth="560"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="#FFFCF8"
                    BorderBrush="#E3DBD1"
                    BorderThickness="1"
                    CornerRadius="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="14,12,14,8">
                        <TextBlock Text="Folders"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#1F1A17"/>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="#6F675F"
                                   Text="Select a folder to scan"/>
                    </StackPanel>
                    <TreeView x:Name="FolderTree"
                              Margin="6,0,6,8"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="2,0,2,4"
                              VirtualizingPanel.IsVirtualizing="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              PreviewMouseLeftButtonUp="FolderTree_PreviewMouseLeftButtonUp"
                              PreviewKeyDown="FolderTree_PreviewKeyDown">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5F2EB"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F1A17"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F2EB"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F1A17"/>

                            <Style x:Key="FolderTreeItem" TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="2,3"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Foreground" Value="#1F1A17"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E5F2EB"/>
                                        <Setter Property="Foreground" Value="#1F1A17"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <StaticResource ResourceKey="FolderTreeItem"/>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               FontSize="14"
                                               Margin="0,0,8,0"
                                               VerticalAlignment="Center"
                                               Foreground="#1F6B4A"
                                               Text="{Binding Glyph}"/>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="12"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="Transparent"
                          ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext"
                          Cursor="SizeWE"/>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0,0,0,14"
                Padding="14"
                Background="#FFFCF8"
                BorderBrush="#E3DBD1"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="78"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Folder"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#3E3832"/>

                <Grid Grid.Column="1">
                    <TextBox x:Name="FolderPathBox"
                             Style="{StaticResource FieldBox}"
                             KeyDown="FolderPathBox_KeyDown"
                             TextChanged="FolderPathBox_TextChanged"/>
                    <TextBlock x:Name="FolderHint"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="#9A9188"
                               Text="Type a folder path"/>
                </Grid>

                <Button x:Name="BrowseButton"
                        Grid.Column="2"
                        Margin="8,0,0,0"
                        Content="Browse"
                        Style="{StaticResource SecondaryButton}"
                        Click="BrowseButton_Click"/>
                <Button x:Name="ScanButton"
                        Grid.Column="3"
                        Margin="8,0,0,0"
                        Content="Scan"
                        Style="{StaticResource PrimaryButton}"
                        Click="ScanButton_Click"/>

                <TextBlock Grid.Row="1"
                           Margin="0,10,0,0"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#3E3832"
                           Text="Search"/>

                <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                    <TextBox x:Name="SearchBox"
                             Style="{StaticResource FieldBox}"
                             TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchHint"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"
                               Foreground="#9A9188"
                               Text="Filter by folder, file name, or path"/>
                </Grid>

                <Button x:Name="ExportButton"
                        Grid.Row="1"
                        Grid.Column="2"
                        Grid.ColumnSpan="2"
                        Margin="8,10,0,0"
                        HorizontalAlignment="Stretch"
                        Content="Export"
                        Style="{StaticResource SecondaryButton}"
                        Click="ExportButton_Click"
                        IsEnabled="False"
                        ToolTip="Save the rows currently shown as Excel, CSV, or PDF">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Excel workbook (.xlsx)" Tag="xlsx" Click="ExportMenu_Click"/>
                            <MenuItem Header="CSV (.csv)" Tag="csv" Click="ExportMenu_Click"/>
                            <MenuItem Header="PDF (.pdf)" Tag="pdf" Click="ExportMenu_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="White"
                BorderBrush="#E3DBD1"
                BorderThickness="1">
            <Grid>
                <DataGrid x:Name="ItemsGrid"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E6DFD4"
                          BorderThickness="0"
                          Background="White"
                          RowBackground="White"
                          AlternatingRowBackground="#F7F4EE"
                          AlternationCount="2"
                          RowHeight="36"
                          ColumnHeaderHeight="38"
                          FontSize="13"
                          Foreground="#1F1A17"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ClipboardCopyMode="ExcludeHeader"
                          MouseDoubleClick="ItemsGrid_MouseDoubleClick"
                          PreviewKeyDown="ItemsGrid_PreviewKeyDown"
                          PreviewMouseRightButtonDown="ItemsGrid_PreviewMouseRightButtonDown">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#E5F2EB"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#1F1A17"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#E5F2EB"/>
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#1F1A17"/>

                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#243027"/>
                            <Setter Property="Foreground" Value="#F6F3EE"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="FontSize" Value="12.5"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="BorderBrush" Value="#314338"/>
                            <Setter Property="BorderThickness" Value="0,0,1,0"/>
                            <Setter Property="HorizontalContentAlignment" Value="Left"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="SeparatorBrush" Value="#314338"/>
                        </Style>

                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Style.Triggers>
                                <Trigger Property="AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#F7F4EE"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F2EB"/>
                                    <Setter Property="Foreground" Value="#1F1A17"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Padding" Value="12,0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E5F2EB"/>
                                    <Setter Property="Foreground" Value="#1F1A17"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Reveal in folder" Click="ContextReveal_Click"/>
                            <MenuItem Header="Copy file path" Click="ContextCopy_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Folder name"
                                            Binding="{Binding FolderName}"
                                            Width="180"
                                            MinWidth="120">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="ToolTip" Value="{Binding FolderName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Filename"
                                            Binding="{Binding FileName}"
                                            Width="220"
                                            MinWidth="140">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="ToolTip" Value="{Binding FileName}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="File path"
                                            Binding="{Binding FilePath}"
                                            Width="*"
                                            MinWidth="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="ToolTip" Value="{Binding FilePath}"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="Type" Width="88" SortMemberPath="Kind">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Kind}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#6F675F"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Kind}" Value="Folder">
                                                        <Setter Property="Foreground" Value="#1F6B4A"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="100" CanUserSort="False" CanUserResize="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Reveal"
                                            Style="{StaticResource RevealButton}"
                                            HorizontalAlignment="Left"
                                            ToolTip="Show this item in File Explorer"
                                            Click="RevealButton_Click"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <TextBlock x:Name="EmptyText"
                           Margin="24,48,24,0"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextAlignment="Center"
                           FontSize="14"
                           Foreground="#6F675F"
                           Text="Choose a folder on the left, or type a path and press Scan."/>
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="2,10,0,0"
                   FontSize="12.5"
                   Foreground="#6F675F"
                   TextTrimming="CharacterEllipsis"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"
                   Text="Choose a folder on the left, type a path, or drop a folder here."/>
            </Grid>
        </Grid>
    </Grid>
</Window>
