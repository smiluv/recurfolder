<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\RecurFolder.ico</ApplicationIcon>
    <ApplicationTitle>RecurFolder</ApplicationTitle>
    <Product>RecurFolder</Product>
    <Version>1.2.0</Version>
    <Description>List every file and folder under a chosen directory.</Description>
    <Company>RecurFolder</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="PDFsharp" Version="6.2.2" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\RecurFolder.ico" />
    <None Remove="Assets\RecurFolder.png" />
    <Resource Include="Assets\RecurFolder.ico" />
    <Resource Include="Assets\RecurFolder.png" />
  </ItemGroup>

</Project>
